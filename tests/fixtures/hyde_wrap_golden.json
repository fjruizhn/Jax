      "/home/fruiz/jax",
      "/home/fruiz/jax",
      "--ro-bind",
      "/home/fruiz/jax-platform",
      "/home/fruiz/jax-platform",
      "--bind",
      "/golden/workspace",
      "/golden/workspace",
      "--tmpfs",
      "/home/hyde-sandbox",
      "--ro-bind",
      "<TEMPLATE_DIR>/.claude.json",
      "/home/hyde-sandbox/.claude.json",
      "--ro-bind",
      "<TEMPLATE_DIR>/.claude/settings.json",
      "/home/hyde-sandbox/.claude/settings.json",
      "--chdir",
      "/golden/workspace",
      "--",
      "claude",
      "-p",
      "--model",
      "modelo-golden",
      "--output-format",
      "text"
    ],
    "env": {
      "CLAUDE_CODE_OAUTH_TOKEN": "tok-centinela-golden-NO-ES-REAL",
      "HOME": "/home/hyde-sandbox",
      "LANG": "C.UTF-8",
      "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    },
    "plantilla_home": {
      ".claude.json": "{\"projects\": {\"/golden/workspace\": {\"hasTrustDialogAccepted\": true}}}\n",
      ".claude/settings.json": "{}\n"
    }
  },
