# --- Credenciales locales (nunca deberían vivir en el repo -- defensivo,
# hoy viven en /etc/jax/.env, fuera de este árbol) ---
.env
*.env
.env.*

# --- Entornos virtuales (no se versionan; se reconstruyen) ---
# Sin barra final: matchea tambien cuando .venv es un symlink (ej: a
# /opt/jax/venv, para no llenar la particion raiz — ver commit "mueve venv").
.venv
*/.venv

# --- Cache de Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Bases de datos y binarios de runtime ---
*.db
ruvector.db

# --- Estado y logs de runtime ---
.swarm/
logs/
*/logs/
*.log
*.out

# --- Backups locales (red de seguridad, no son fuente) ---
*.backup-*
*.bak
*.bak-*
backups/
*.bak.*
*.FERNANDO-*

# --- Artefactos generados por facetas (respuestas de runtime, no son fuente) ---
# Patrón <hash>_NN_<faceta>.md generado por el motor; bibox-concepto.md y demás docs reales se preservan
repo/documents/*_[0-9][0-9]_*.md

# --- Web-tasks transitorios (estado de runtime; los briefs hechos a mano sí se versionan) ---
missions/web-task-*

# --- Almacén de artifacts de Jacobs (outputs grandes de runtime; NO el módulo artifacts.py) ---
jacobs/artifacts/

# --- Misc ---
que
.../

# Config local de Claude Code (por máquina)
.claude/settings.local.json

keyd/

# --- Artefactos generados por ruflo / claude-flow (regenerables con `ruflo init`) ---
# Toda la huella es auto-generada; nada es fuente de JAX. memory.db/settings.local.json
# ya quedan cubiertos por *.db y reglas previas; aquí va el resto.
las_manos/.claude-flow/
las_manos/.claude/
las_manos/.mcp.json
las_manos/CLAUDE.md
.claude-flow/
.claude/proven-config.json
.claude/.proven-config-version
.worktrees/

# GAP2 Fase4 (2026-08-19): workspace/ vivió acá como directorio gitignored
# con su propio repo git anidado. Se perdió DOS VECES en 20h (2026-08-21)
# porque cualquier limpieza del repo padre (filter-repo, git clean -x) se
# lleva puesto lo que está gitignored, sin avisar -- ver DEUDA.md. Fix real:
# JAX_WORKSPACE_DIR (/etc/jax/.env) apunta fuera de este árbol, a
# /home/fruiz/jax-workspace. Esta entrada ya no aplica (nada debería
# escribir workspace/ acá), se deja sin regla activa a propósito: si algo
# alguna vez recrea workspace/ DENTRO de jax/, mejor que git lo vea y falle
# ruidoso a que vuelva a desaparecer en silencio la próxima limpieza.
