# ops/ejecutor/ejecutor-vigia@.service — Ejecutor SP1 plan 6: una misión = una instancia.
# %i = id de la misión; la misión es ${JAX_EJECUTOR_MISIONES}/%i.json ({"mision": texto, "hosts": [...]}).
# Antes de latir exige los seis contratos (jax.ejecutor.contratos.arranque) con las máquinas de la
# misión: si alguno no está vivo sale 1 sin latir y el proxy de C3 sigue en 423.
# Restart=no a propósito: un vigía que se reinicia solo perdería el byte donde empezó la misión;
# si muere, la pausa (vigia_caido) o su latido viejo dejan al proxy en 423 hasta que alguien mire.
# SIGTERM = fin normal: audita lo pendiente, borra el latido y el proxy vuelve a 423 en el acto.
[Unit]
Description=Ejecutor · vigía de C5 de la misión %i (arranque condicionado a los seis contratos)
After=network.target jax-ejecutor-proxy.service ejecutor-freno.service

[Service]
Type=simple
User=fruiz
WorkingDirectory=/home/fruiz/jax
EnvironmentFile=/etc/jax/.env
Environment=PYTHONPATH=/home/fruiz/jax:/home/fruiz/jax/las_manos
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/fruiz/jax/.venv/bin/python -m jax.ejecutor.contratos.vigia_servicio ${JAX_EJECUTOR_MISIONES}/%i.json
Restart=no
KillSignal=SIGTERM
# El auditor tiene un tope de 120 s por lote (auditor_cliente.py); el último lote se audita al parar.
TimeoutStopSec=150
