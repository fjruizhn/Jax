# ops/ejecutor/ejecutor-freno.service.plantilla — la renderiza jax.ejecutor.contratos.instalacion
[Unit]
Description=Ejecutor C4 freno en vuelo de la cuenta del Ejecutor
After=local-fs.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/jax/.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=ejecutor-freno
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 -I -c "import sys; sys.path.insert(0, '@LIB@'); from jax.ejecutor.contratos.freno import principal; sys.exit(principal())"
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
