  "risks": [
    {
      "id": "R1",
      "risk": "Voz correcta pero robótica",
      "impact": "HIGH",
      "mitigation": "Voice eval gate + A/B + Speech Renderer + prosody tuning"
    },
    {
      "id": "R2",
      "risk": "Latencia rompe conversación",
      "impact": "CRITICAL",
      "mitigation": "Streaming E2E + budget por tramo + observability"
    },
    {
      "id": "R3",
      "risk": "Barge-in falla",
      "impact": "HIGH",
      "mitigation": "cancel token + VAD edge + interruption SLO"
    },
    {
      "id": "R4",
      "risk": "Dos agentes escriben mismo boundary",
      "impact": "HIGH",
      "mitigation": "Ariadna + task lease + worktree ownership"
    },
    {
      "id": "R5",
      "risk": "Skills divergen entre harnesses",
      "impact": "HIGH",
      "mitigation": "canonical registry + generated projections + hash drift gate"
    },
    {
      "id": "R6",
      "risk": "Audio 24/7 invade privacidad",
      "impact": "CRITICAL",
      "mitigation": "no continuous upstream; wake/VAD local; explicit sessions"
    },
    {
      "id": "R7",
      "risk": "Telefonía ejecuta acción no autorizada",
      "impact": "CRITICAL",
      "mitigation": "human gate, allowlists, Intent Envelope, audit, fail-closed"
    },
    {
      "id": "R8",
      "risk": "Licencia incompatible con comercialización",
      "impact": "HIGH",
      "mitigation": "SBOM + license gate"
    },
    {
      "id": "R9",
      "risk": "Modelos locales saturan GPU",
      "impact": "HIGH",
      "mitigation": "ResourceManager + quotas + profiling"
    },
    {
      "id": "R10",
      "risk": "Anteojos/wake consumen batería o activan falso",
      "impact": "MEDIUM",
      "mitigation": "PTT first + benchmark edge"
    }
  ],
