    "id": "las-voces",
    "name": "LAS VOCES",
    "subtitle": "Canal humano de JAX — voz natural, ubicua, soberana y gobernada",
    "status": "PLANNING",
    "version": "0.1.0",
    "created": "2026-09-27",
    "target_rc": "2026-11-30",
    "target_rc_note": "Objetivo operativo, no compromiso contractual.",
    "program": "AXIOMA 3.0",
    "sponsor": "Fernando Ruiz",
    "human_authority": "Fernando",
    "primary_builder": "Qwen local",
    "project_manager_agent": "Ariadna (propuesta)",
    "principle": "Software libre primero. Memoria ≠ autoridad. Memoria ≠ evidencia."
  },
  "north_star": {
    "statement": "Hablar con JAX debe sentirse como presencia, no como usar un asistente de voz.",
    "experience": [
      "Voz humana, consistente y no robotizada.",
      "Respuesta audible rápida y progresiva.",
      "Barge-in real: Fernando puede interrumpir y JAX se calla.",
      "Turn-taking natural, sin silencios artificiales.",
      "Continuidad mediante B9 sin convertir memoria en autoridad.",
      "Acceso 24/7 desde teléfono y anteojos inteligentes.",
      "Telefonía UCM6300: recibir, filtrar y realizar llamadas bajo política."
    ]
  },
  "slo_targets": [
    {
      "metric": "First audible response",
      "target": "P50 ≤ 700 ms; P95 ≤ 1.2 s",
      "note": "Meta inicial; validar empíricamente."
    },
    {
      "metric": "Barge-in mute",
      "target": "≤ 200 ms",
      "note": "Desde detección de voz hasta corte perceptual del TTS."
    },
    {
      "metric": "Voice naturalness",
      "target": "≥ 4.2/5",
      "note": "Pruebas A/B humanas."
    },
    {
      "metric": "Voice identity consistency",
      "target": "≥ 4.5/5",
      "note": "Misma identidad perceptual entre sesiones."
    },
    {
      "metric": "ASR Spanish quiet",
      "target": "WER ≤ 8%",
      "note": "Meta inicial; recalibrar con dataset propio."
    },
    {
      "metric": "ASR noisy/mobile",
      "target": "WER ≤ 15%",
      "note": "Automóvil/calle/anteojos."
    },
    {
      "metric": "Domain term recall",
      "target": "≥ 95%",
      "note": "JAX/Axioma/nombres técnicos."
    },
    {
      "metric": "Voice availability",
      "target": "≥ 99.5% inicial",
      "note": "Subir después de hardening."
    }
  ],
