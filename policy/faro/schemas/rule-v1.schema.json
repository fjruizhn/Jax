{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axioma/ecosistema/policy/faro/schemas/rule-v1.schema.json",
  "title": "Regla Faro v1 (JAX_FARO_RULE)",
  "description": "Espejo estructural y lexico del shape cerrado de policy/rule_authority/schema.py (F1.1 §7 + R-4). Habilite un date-time FormatChecker para validar fechas; JSON Schema estándar no puede comparar los extremos del intervalo. Solo validar_regla() produce una regla confiable y debe ejecutarse siempre. Ninguna regla real existe hoy; los ejemplos ratificables viven solo como fixtures de prueba.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "rule_id",
    "effect",
    "action_class",
    "scope",
    "obligation_limits",
    "validity",
    "permit"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "kind": {
      "enum": [
        "JAX_FARO_RULE"
      ]
    },
    "rule_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "effect": {
      "enum": [
        "PERMIT"
      ]
    },
    "action_class": {
      "enum": [
        "REVERSIBLE",
        "OBLIGATING"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjects",
        "capabilities",
        "objectives"
      ],
      "properties": {
        "subjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(human|actor):[a-z][a-z0-9-]{0,63}$"
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      }
    },
    "obligation_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "amount",
        "frequency"
      ],
      "properties": {
        "quantity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unit",
                "max"
              ],
              "properties": {
                "unit": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740992
                }
              }
            }
          ]
        },
        "amount": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "currency",
                "max"
              ],
              "properties": {
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740992
                }
              }
            }
          ]
        },
        "frequency": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_occurrences",
                "window_seconds"
              ],
              "properties": {
                "max_occurrences": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740992
                },
                "window_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740992
                }
              }
            }
          ]
        }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "not_before_utc",
        "not_after_utc"
      ],
      "properties": {
        "not_before_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "not_after_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            }
          ]
        }
      }
    },
    "permit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ttl_seconds"
      ],
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "tope": {
      "description": "R-4 (decision de Fernando 2026-10-06): catalogo cerrado de actos y dinero. null significa ausencia de tope. resource = <clase>.<subid> del catalogo de ESA clase; conexiones/concurrencia/workers/hilos/procesos/agentes no existen en el (D-4).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_class", "resource", "maximum", "period"],
          "properties": {
        "resource_class": {
          "enum": [
            "actos_externos",
            "duracion",
            "frecuencia",
            "monto_dinero",
            "tokens_costo"
          ]
        },
        "resource": {
          "type": "string",
          "description": "<clase>.<subid> del catalogo cerrado (policy/faro/catalogo-topes.json). Atado a SU clase por oneOf: un subid de otra clase no pasa."
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        },
        "period": {
          "type": "string",
          "enum": ["por_dia", "por_hora"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "resource_class": {
              "const": "actos_externos"
            },
            "resource": {
              "enum": [
                "actos_externos.compras",
                "actos_externos.correos",
                "actos_externos.mensajes",
                "actos_externos.pagos",
                "actos_externos.publicaciones"
              ]
            }
          },
          "required": [
            "resource_class",
            "resource"
          ]
        },
        {
          "properties": {
            "resource_class": {
              "const": "duracion"
            },
            "resource": {
              "enum": [
                "duracion.segundos"
              ]
            }
          },
          "required": [
            "resource_class",
            "resource"
          ]
        },
        {
          "properties": {
            "resource_class": {
              "const": "frecuencia"
            },
            "resource": {
              "enum": [
                "frecuencia.por_dia",
                "frecuencia.por_hora"
              ]
            }
          },
          "required": [
            "resource_class",
            "resource"
          ]
        },
        {
          "properties": {
            "resource_class": {
              "const": "monto_dinero"
            },
            "resource": {
              "enum": [
                "monto_dinero.hnl",
                "monto_dinero.usd"
              ]
            }
          },
          "required": [
            "resource_class",
            "resource"
          ]
        },
        {
          "properties": {
            "resource_class": {
              "const": "tokens_costo"
            },
            "resource": {
              "enum": [
                "tokens_costo.tokens",
                "tokens_costo.usd"
              ]
            }
          },
          "required": [
            "resource_class",
            "resource"
          ]
        }
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"action_class": {"const": "OBLIGATING"}}},
      "then": {
        "properties": {
          "validity": {"properties": {"not_after_utc": {"type": "string"}}},
          "obligation_limits": {
            "properties": {"frequency": {"type": "object"}},
            "oneOf": [
              {"properties": {"quantity": {"type": "object"}, "amount": {"type": "null"}}},
              {"properties": {"quantity": {"type": "null"}, "amount": {"type": "object"}}}
            ]
          }
        }
      }
    }
  ]
}
