[Unit]
Description=JAX LAS VOCES governed Ariadna PM host
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/jax/ariadna-pm.kill

[Service]
Type=simple
User=jaxsvc
Group=jaxsvc
WorkingDirectory=/srv/jax-prod/jax
EnvironmentFile=/etc/jax/.env
ExecStart=/srv/jax-prod/jax/.venv/bin/python /srv/jax-prod/jax/scripts/ariadna_host.py --config /etc/jax/ariadna-pm.json --run-forever
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/srv/jax-prod/jax/projects/las-voces /srv/jax-prod/jax/.git

[Install]
WantedBy=multi-user.target
