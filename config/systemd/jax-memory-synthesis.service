[Unit]
Description=JAX — Worker de sintesis de segundo orden (item #8, insights sobre facts YA verificados)
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=fruiz
WorkingDirectory=/home/fruiz/jax
EnvironmentFile=/etc/jax/.env
Environment=PYTHONPATH=/home/fruiz/jax
ExecStart=/home/fruiz/jax/.venv/bin/python -m jax.memory.synthesis_worker
StandardOutput=journal
StandardError=journal
