# /etc/systemd/system/jax-memory-worker.service
[Unit]
Description=JAX — Worker de memoria (destila facts/decisiones/pendientes con scope de dos niveles)
After=network.target docker.service
Wants=docker.service

[Service]
Type=oneshot
User=jaxsvc
Group=jaxsvc
WorkingDirectory=/srv/jax-prod/jax
EnvironmentFile=/etc/jax/.env
ExecStart=/srv/jax-prod/jax/.venv/bin/python -m jax.memory.worker
StandardOutput=journal
StandardError=journal
